# Copy this file to a real .env (or export these as system/IDE environment
# variables) and fill in your actual local MySQL credentials.
# NEVER commit a real .env file with real passwords to Git.

SERVER_PORT=8080

DB_HOST=localhost
DB_PORT=3306
DB_NAME=medicare_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

DDL_AUTO=update
SHOW_SQL=true

# JWT signing secret - must be at least 32 characters long. Generate
# your own random value for anything beyond local development, e.g.
# using: openssl rand -base64 32
JWT_SECRET=this-is-a-local-dev-only-secret-key-change-me-1234567890
JWT_EXPIRATION_MS=86400000

# ---- SMS reminders (Phases 10-12) ----
# mock = log only (default). twilio = really send (fill in the 3 values below).
SMS_PROVIDER=gateway
SMS_GATEWAY_API_KEY=your_new_textbee_key
# SMS_MOCK_FAIL=true            # mock only: simulate failed sends
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx
# SMS_DEFAULT_COUNTRY_CODE=+91
# REMINDER_ENABLED=true
# REMINDER_CRON=0 0/15 * * * *   # every 15 minutes
# REMINDER_LEAD_HOURS=24
# REMINDER_MAX_ATTEMPTS=3
# APP_TIMEZONE=Asia/Kolkata

# ---- First-admin bootstrap (creates an ADMIN only if that username doesn't exist) ----
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_EMAIL=
